[Unit]
Description=FS inode caching

[Service]
Type=oneshot
ExecStart=dircacher --dir-file /etc/dircachertab

# Reduce impact on active system
OOMScoreAdjust=10
CPUSchedulingPolicy=idle
# no actual effect because of CPUSchedulingPolicy=idle
# set to aid process monitors
Nice=19
# lowest IO priority possible
IOSchedulingClass=idle
IOSchedulingPriority=7

# Security
SystemCallFilter=@file-system @basic-io @io-event @process @signal madvise
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
SecureBits=noroot-locked
NoNewPrivileges=yes
LimitMEMLOCK=0
LimitFSIZE=0

# Tinfoil hat
LockPersonality=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
